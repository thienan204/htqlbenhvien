  NAM_SX        Int?
  NAM_SD        Int?
  MA_MAY        String?
  TEN_BV        String?
  SO_LUU_HANH   String?  @db.VarChar(20)
  HD_TU         String?  @db.VarChar(8)
  HD_DEN        String?  @db.VarChar(8)
  TU_NGAY       String?  @db.VarChar(8)
  DEN_NGAY      String?  @db.VarChar(8)
  MA_CSKCB      String?  @db.VarChar(5)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  loai_may_code String?
}

model MachineLocationHistory {
  id        String    @id @default(uuid())
  ma_may    String
  ma_khoa   String
  tu_ngay   DateTime?
  den_ngay  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model ITRequest {
  id               String           @id @default(cuid())
  ma_ba            String?
  ten_loi          String
  ma_khoa          String
  assigneeId       String?
  status           String           @default("PENDING")
  dynamicFields    Json?
  it_note          String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  category         String           @default("SOFTWARE")
  transferFromId   String?
  transferToId     String?
  resolvedAt       DateTime?
  startedAt        DateTime?
  targetDepartment String           @default("CNTT")
  messages         RequestMessage[]
}

model RequestMessage {
  id          String    @id @default(cuid())
  itRequestId String
  senderId    String
  senderName  String?
  content     String?
  imageUrl    String?
  isSystem    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  itRequest   ITRequest @relation(fields: [itRequestId], references: [id], onDelete: Cascade)
}

model PageInstruction {
  id          String   @id @default(cuid())
  pageId      String   @unique
  title       String?  @db.VarChar(500)
  description String?  @db.Text
  content     String   @db.Text
  showOnPage  Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model XmlErrorRecord {
  id                     String    @id @default(cuid())
  ma_lk                  String?
  ma_bn                  String?
  ma_khoa                String?
  ten_khoa               String?
  ho_ten                 String?
  ma_the                 String?
  ngay_vao               DateTime?
  ngay_ra                DateTime?
  ngay_yl                DateTime?
  ngay_th_yl             DateTime?
  ngay_kq                DateTime?
  ngay_vao_noi_tru       DateTime?
  ma_dv                  String?
  ten_dv                 String?
  ma_doituong_kcb        String?
  chi_tiet_loi           String?
  khoang_thoi_gian_trung String?
  status                 String    @default("PENDING")
  departmentNote         String?
  adminNote              String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  sourceType             String    @default("XML")
  don_gia_bh             String?
  ma_may                 String?
  ma_bac_si              String?
  ten_bac_si             String?
  nguoi_th               String?
  ten_nguoi_th           String?
  itRequestId            String?
  itRequestPingCount     Int       @default(0)
  itResolved             Boolean   @default(false)
}

model Role {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  permissions Json?
}

model Menu {
  id             String   @id @default(cuid())
  title          String
  path           String?
  icon           String?
  parentId       String?
  order          Int      @default(0)
  permissionCode String?
  isActive       Boolean  @default(true)
  isSpecialGroup String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  targetPath     String?
  showInPaths    String[] @default([])
}

model DashboardCard {
  id          String   @id @default(cuid())
  title       String
  description String?
  icon        String?
  href        String
  bgColor     String?
  borderColor String?
  hoverColor  String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Warehouse {
  id             String             @id @default(cuid())
  code           String             @unique
  name           String
  department_id  String
  warehouse_type String
  room           String?
  storekeeper_id String?
  status         String             @default("ACTIVE")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  equipments     Equipment[]
  vouchersAsFrom InventoryVoucher[] @relation("FromWarehouse")
  vouchersAsTo   InventoryVoucher[] @relation("ToWarehouse")
  department     Department         @relation(fields: [department_id], references: [ma_khoa])
  storekeeper    Staff?             @relation(fields: [storekeeper_id], references: [id])
}

model Equipment {
  id                 String            @id @default(cuid())
  ma_vttb            String            @unique
  ten_vttb           String
  qr_code            String            @unique
  category_id        String?
  group_id           String?
  type_id            String?
  manufacturer_id    String?
  country_id         String?
  production_year_id String?
  funding_source_id  String?
  donvitinh          String?
  vattu_hay_tb       String?
  kyhieu             String?
  serial             String?
  quanly_serial      Boolean           @default(false)
  dongia             Float?
  vat                Float?
  dongia_vat         Float?
  dv_cungung         String?
  bao_hanh           Boolean           @default(false)
  ngay_bdbh          DateTime?
  ngay_ktbh          DateTime?
  pp_tinh_khauhao    String?
  thoigian_khauhao   Int?
  ten_ketoan         String?
  status             String            @default("TRONG_KHO")
  warehouse_id       String
  custom_fields      Json?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  quantity           Int               @default(1)
  voucher_id         String?
