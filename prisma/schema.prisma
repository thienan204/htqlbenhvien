// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ValidationRule {
  id              String   @id @default(cuid())
  active          Boolean  @default(true)
  type            String   // 'Xuất toán' | 'Cảnh báo'
  xmlType         String   // XML1, XML2, ...
  field           String?
  name            String
  description     String?
  code            String
  mathExpression  String?
  checkNotNull    Boolean  @default(false)
  conditionField  String?
  conditionValue  String?
  conditionMaDichVu String?
  conditionMaDichVuValue String?
  errorMessage    String?
  isGroupCount    Boolean  @default(false)
  minCountVal     Int?
  maxCountVal     Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
model FormConfig {
  id        String   @id @default(cuid())
  formId    String   @unique
  layout    String?  @db.Text
  settings  String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  name      String?
  role      String   @default("USER") // 'ADMIN', 'USER', 'KHOA', 'CNTT'
  ma_khoa   String?
  telegram_id String? // Username hoặc ID Telegram để Bot tag tên
  
  // Quản lý ca trực (Dành riêng cho Role CNTT)
  isAvailable Boolean  @default(false)
  dutyOrder   Int      @default(999)

  // Liên kết với Hồ sơ Nhân viên (Dành cho tài khoản cá nhân)
  staffId     String?  @unique
  staff       Staff?   @relation(fields: [staffId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DraftRule {
  id              String   @id @default(cuid())
  active          Boolean  @default(true)
  type            String   // 'Xuất toán' | 'Cảnh báo'
  xmlType         String   // XML1, XML2, ...
  field           String?
  name            String
  description     String?
  code            String
  mathExpression  String?
  checkNotNull    Boolean  @default(false)
  conditionField  String?
  conditionValue  String?
  conditionMaDichVu String?
  conditionMaDichVuValue String?
  errorMessage    String?
  isGroupCount    Boolean  @default(false)
  minCountVal     Int?
  maxCountVal     Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Department {
  ma_khoa         String   @id
  ten_khoa        String
  type            String   @default("CLINICAL") // 'CLINICAL' (Lâm sàng) hoặc 'MANAGEMENT' (Phòng quản lý)
  staff           Staff[]
  warehouses      Warehouse[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Staff {
  id              String   @id @default(cuid())
  ho_ten          String
  ma_bac_si       String   @unique
  // Bỏ đi các trường String tĩnh
  // trinh_do        String?
  // chuc_danh       String?
  
  so_dien_thoai   String?
  dia_chi         String?
  ma_khoa         String
  department      Department @relation(fields: [ma_khoa], references: [ma_khoa])
  
  // Các quan hệ Danh mục SystemCategory
  trinh_do_id        String?
  trinh_do_ref       SystemCategory? @relation("StaffQualification", fields: [trinh_do_id], references: [id])
  
  chuc_danh_id       String?
  chuc_danh_ref      SystemCategory? @relation("StaffJobTitle", fields: [chuc_danh_id], references: [id])

  vi_tri_viec_lam_id String?
  vi_tri_ref         SystemCategory? @relation("StaffJobPosition", fields: [vi_tri_viec_lam_id], references: [id])
  
  chuc_vu_id         String?
  chuc_vu_ref        SystemCategory? @relation("StaffPosition", fields: [chuc_vu_id], references: [id])
  
  loai_hop_dong_id   String?
  loai_hop_dong_ref  SystemCategory? @relation("StaffContractType", fields: [loai_hop_dong_id], references: [id])

  gioi_tinh_id       String?
  gioi_tinh_ref      SystemCategory? @relation("StaffGender", fields: [gioi_tinh_id], references: [id])

  ngay_sinh          DateTime?

  // Liên kết 1-Nhiều tới bảng Chứng chỉ hành nghề (Mảng các CCHN)
  certificates       PracticingCertificate[]

  // Liên kết với Tài khoản (1-1)
  user            User?
  
  // Liên kết Quản lý kho
  storekeeper_warehouses Warehouse[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SystemCategory {
  id          String   @id @default(cuid())
  type        String   // VD: 'GENDER', 'LOAI_HOP_DONG', 'VI_TRI_VIEC_LAM', 'TRINH_DO', 'CHUC_DANH', 'CHUC_VU'
  code        String   
  name        String   
  description String?
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  
  // Liên kết động tới bảng Staff
  staff_hop_dong   Staff[] @relation("StaffContractType")
  staff_vi_tri     Staff[] @relation("StaffJobPosition")
  staff_chuc_danh  Staff[] @relation("StaffJobTitle")
  staff_trinh_do   Staff[] @relation("StaffQualification")
  staff_chuc_vu    Staff[] @relation("StaffPosition")
  staff_gioi_tinh  Staff[] @relation("StaffGender") 
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([type, code]) 
}

model PracticingCertificate {
  id                 String   @id @default(cuid())
  staffId            String   
  staff              Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  
  so_cchn            String   // "Số chứng chỉ hành nghề đăng ký với BHYT"
  ngay_cap           DateTime? // "Ngày cấp"
  chuc_danh_cchn     String?  // "CDNN trong CCHN"
  pham_vi_hanh_nghe  String?  // "Phạm vi hành nghề"
  pham_vi_bo_sung    String?  // "Phạm vi chuyên môn bổ sung"
  dich_vu_ky_thuat   String?  // "Dịch vụ kỹ thuật khác"
  isActive           Boolean  @default(true) // Đánh dấu CCHN nào đang được sử dụng chính
  
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model DuplicateRule {
  id                  String   @id @default(cuid())
  name                String
  machineCols         String[]
  serviceCol          String?
  startCol            String
  endCol              String
  ignoreMaMayMinusOne Boolean  @default(false)
  ignoreNullValues    Boolean  @default(false)
  active              Boolean  @default(true)
  serviceValues       String[]
  excludedServiceValues String[]
  ignoreIfSameField   String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model SpecializedRule {
  id          String   @id @default(cuid())
  name        String   // Display Name (Menu Label)
  slug        String   @unique // URL path segment (e.g., 'kiem-tra-thuoc')
  description String?
  isActive    Boolean  @default(true)
  order       Int      @default(0) // For menu sorting
  
  // Rule Classification
  ruleType    String   // 'SQL', 'DUPLICATE_BED', 'MACHINE_CHECK', 'GROUP_15', etc.

  // Logic Configuration
  logicConfig Json?    // Flexible storage for rule parameters
  sqlQuery    String?  // Optional: Direct SQL for advanced users

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DepartmentCatalog {
  id          String   @id @default(uuid())
  STT         Int?
  MA_KHOA     String   @db.VarChar(50)
  TEN_KHOA    String   @db.Text
  BAN_KHAM    Int?
  GIUONG_PD   Int?
  GIUONG_TK   Int?
  GIUONG_HSTC Int?
  GIUONG_HSCC Int?
  TU_NGAY     String?  @db.VarChar(8)
  DEN_NGAY    String?  @db.VarChar(8)
  MA_CSKCB    String?  @db.VarChar(5)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

