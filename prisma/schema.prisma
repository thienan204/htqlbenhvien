  TINHNANG_KT   String?
  QUY_CACH      String?
  HANG_SX       String?
  NUOC_SX       String?  @db.VarChar(100)
  DON_VI_TINH   String?  @db.VarChar(50)
  DON_GIA       Float?
  DON_GIA_BH    Float?
  TYLE_TT_BH    Float?
  SO_LUONG      Float?
  DINH_MUC      Float?
  NHA_THAU      String?
  TT_THAU       String?  @db.VarChar(50)
  TU_NGAY_HD    String?  @db.VarChar(8)
  DEN_NGAY_HD   String?  @db.VarChar(8)
  MA_CSKCB      String?  @db.VarChar(5)
  LOAI_THAU     Int?
  HT_THAU       Int?
  MA_CSKCB_TBYT String?  @db.VarChar(5)
  TU_NGAY       String?  @db.VarChar(8)
  DEN_NGAY      String?  @db.VarChar(8)
  isActive      Boolean  @default(true)
