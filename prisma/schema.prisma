model ITRequest {
  id              String   @id @default(cuid())
  ma_ba           String?  // MABA (Mã bệnh án)
  category        String   @default("SOFTWARE") // SOFTWARE, HARDWARE
  ten_loi         String   // Tên lỗi yêu cầu / Mô tả lỗi
  ma_khoa         String   // Khoa gửi yêu cầu
  
  assigneeId      String?  // Giao người xử lý
  status          String   @default("PENDING") // PENDING, IN_PROGRESS, RESOLVED, TRANSFERRING
  dynamicFields   Json?    // Chứa cấu trúc các trường từ Form Builder
  it_note         String?  @db.Text
  
  // Fields for Transfer Workflow
  transferToId    String?
  transferFromId  String?
  
  // Time tracking fields
  startedAt       DateTime?
  resolvedAt      DateTime?
  
  // Chat Messages
  messages        RequestMessage[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model RequestMessage {
  id              String   @id @default(cuid())
  itRequestId     String
  itRequest       ITRequest @relation(fields: [itRequestId], references: [id], onDelete: Cascade)
  senderId        String   // ID người gửi (có thể là ID của User)
  senderName      String?  // Tên người gửi hiển thị
  content         String?  @db.Text // Nội dung chat
  imageUrl        String?  // Ảnh đính kèm nếu có
  isSystem        Boolean  @default(false) // Có phải tin nhắn tự động từ hệ thống không
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model XmlErrorRecord {
  id                String   @id @default(cuid())
  ma_lk             String?
  ma_bn             String?
  ma_khoa           String?
  ten_khoa          String?
  ho_ten            String?
  ma_the            String?
  ngay_vao          DateTime?
  ngay_ra           DateTime?
  ngay_yl           DateTime?
  ngay_th_yl        DateTime?
  ngay_kq           DateTime?
  ngay_vao_noi_tru  DateTime?
  ma_dv             String?
  ten_dv            String?
  don_gia_bh        String?
  ma_doituong_kcb   String?
  chi_tiet_loi      String?  @db.Text
  sourceType        String   @default("XML") // XML, CHUYEN_DE

  status            String   @default("PENDING") // PENDING, EXPLAINED
  departmentNote    String?  @db.Text // Giải trình của khoa
  adminNote         String?  @db.Text // Ghi chú của Admin
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Role {
  id          String   @id @default(cuid())
  code        String   @unique // ADMIN, CNTT, KHOA...
  name        String   // Tên hiển thị
  description String?
  permissions Json?    // Danh sách các mã menu được phép truy cập
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Menu {
  id              String   @id @default(cuid())
  title           String   // Tên hiển thị (vd: Đọc dữ liệu Excel)
  path            String?  // Đường dẫn hiển thị (vd: /doc-file-excel-1)
  targetPath      String?  // Đường dẫn gốc (vd: /doc-file-excel)
  icon            String?  // Tên Icon của Ant Design (vd: FileExcelOutlined)
  parentId        String?  // Dùng để tạo cấp bậc (Nhóm menu hoặc menu con)
  order           Int      @default(0) // Số thứ tự để lưu vị trí kéo thả
  permissionCode  String?  // Mã quyền (vd: MENU_DOC_FILE_EXCEL) để link với bảng Role
  isActive        Boolean  @default(true)
  isSpecialGroup  String?  // Dùng để đánh dấu các nhóm đặc biệt (như nhóm "Chuyên đề" tự động load từ bảng SpecializedRule)
  showInPaths     String[] @default([]) // Chứa tiền tố đường dẫn module (vd: ['/xml-checker'])
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model DashboardCard {
  id              String   @id @default(cuid())
  title           String   // Tiêu đề (VD: Quản lý Nhân sự)
  description     String?  // Mô tả chi tiết
  icon            String?  // Tên Icon (VD: TeamOutlined)
  href            String   // Đường dẫn (VD: /staff)
  
  // Giao diện thẻ
  bgColor         String?  // VD: bg-cyan-50
  borderColor     String?  // VD: border-cyan-200
  hoverColor      String?  // VD: hover:border-cyan-500
  
  order           Int      @default(0) // Số thứ tự hiển thị
  isActive        Boolean  @default(true) // Trạng thái Bật/Tắt
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Warehouse {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  department_id   String
  department      Department @relation(fields: [department_id], references: [ma_khoa])
  warehouse_type  String   // KHO_CHINH, KHO_KHOA
  room            String?
  storekeeper_id  String?
  storekeeper     Staff?   @relation(fields: [storekeeper_id], references: [id])
  status          String   @default("ACTIVE") // ACTIVE, INACTIVE

  equipments      Equipment[]
  vouchersAsFrom  InventoryVoucher[] @relation("FromWarehouse")
  vouchersAsTo    InventoryVoucher[] @relation("ToWarehouse")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Equipment {
  id                 String   @id @default(cuid())
  ma_vttb            String   @unique
  ten_vttb           String
  qr_code            String   @unique
  quantity           Int      @default(1) // Cho vật tư tiêu hao
  
  // Phân loại (Trỏ đến SystemCategory)
  category_id        String?  
  group_id           String?
  type_id            String?
  manufacturer_id    String?
  country_id         String?
  production_year_id String?
  funding_source_id  String?

  donvitinh          String?
  vattu_hay_tb       String? // VAT_TU, THIET_BI
  kyhieu             String?
  serial             String?
  quanly_serial      Boolean  @default(false)
  dongia             Float?
  vat                Float?
  dongia_vat         Float?
  dv_cungung         String?
  bao_hanh           Boolean  @default(false)
  ngay_bdbh          DateTime?
  ngay_ktbh          DateTime?
  pp_tinh_khauhao    String?
  thoigian_khauhao   Int?
  ten_ketoan         String?

  status             String   @default("TRONG_KHO") // TRONG_KHO, DANG_SU_DUNG, BAO_HONG, THANH_LY
  warehouse_id       String
  warehouse          Warehouse @relation(fields: [warehouse_id], references: [id])
  
  custom_fields      Json?    // Chứa dữ liệu động

  voucher_id         String?  // Trỏ đến phiếu nhập kho đã sinh ra thiết bị này
  voucher            InventoryVoucher? @relation(fields: [voucher_id], references: [id])

  maintenanceLogs    MaintenanceLog[]

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model InventoryVoucher {
  id                String   @id @default(cuid())
  voucher_code      String   @unique
  type              String   // NHAP_KHO, XUAT_KHO, LUAN_CHUYEN, TRA_HANG
  sub_type          String?  // NHAP_MOI, NHAP_HOAN_TRA, XUAT_SU_DUNG, XUAT_CHUYEN_KHO, XUAT_TRA_NCC
  
  // Dùng khi nhập từ nhà cung cấp
  supplier_name     String?
  document_number   String?
  document_date     DateTime?
  deliverer_name    String?
  deliverer_address String?
  received_date     DateTime?

  // Kho điều chuyển
  from_warehouse_id String?
  from_warehouse    Warehouse? @relation("FromWarehouse", fields: [from_warehouse_id], references: [id])
  to_warehouse_id   String?
  to_warehouse      Warehouse? @relation("ToWarehouse", fields: [to_warehouse_id], references: [id])
  
  status            String   @default("PENDING") // PENDING, APPROVED, REJECTED
  created_by        String   // Tên hoặc ID người lập
  
  details           InventoryVoucherDetail[]
  equipments        Equipment[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model InventoryVoucherDetail {
  id               String   @id @default(cuid())
  voucher_id       String
  voucher          InventoryVoucher @relation(fields: [voucher_id], references: [id], onDelete: Cascade)
  
  ten_vttb         String
  category_id      String?
  group_id         String?
  type_id          String?
  
  quantity         Int      @default(1)
  dongia           Float?
  vat              Float?
  dongia_vat       Float?
  thanh_tien       Float?

  // Lưu thông tin hãng SX, năm... lúc nhập vào
  manufacturer_id  String?
  country_id       String?
  funding_source_id String?
  serial_numbers   String?  @db.Text
  is_auto_generate Boolean  @default(true)
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model MaintenanceLog {
  id                  String   @id @default(cuid())
  equipment_id        String
  equipment           Equipment @relation(fields: [equipment_id], references: [id], onDelete: Cascade)
  
  reported_by         String?  // ID khoa báo hỏng hoặc tên
  issue_description   String   @db.Text
  handled_by          String?  // ID người sửa
  status              String   @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  cost                Float?
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}
