generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ValidationRule {
  id                     String   @id @default(cuid())
  active                 Boolean  @default(true)
  type                   String
  xmlType                String
  field                  String?
  name                   String
  description            String?
  code                   String
  conditionField         String?
  conditionValue         String?
  errorMessage           String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  checkNotNull           Boolean  @default(false)
  conditionMaDichVu      String?
  conditionMaDichVuValue String?
  excludeConditionField  String?
  excludeConditionValue  String?
  isGroupCount           Boolean  @default(false)
  mathExpression         String?
  maxCountVal            Int?
  minCountVal            Int?
}

model FormConfig {
  id        String   @id @default(cuid())
  formId    String   @unique
  layout    String?
  settings  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id           String            @id @default(cuid())
  username     String            @unique
  password     String
  name         String?
  role         String            @default("USER")
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  dutyOrder    Int               @default(999)
  isAvailable  Boolean           @default(false)
  ma_khoa      String?
  telegram_id  String?
  staffId      String?           @unique
  userHIS      String?           @unique
  idHIS        String?           @unique
  staff        Staff?            @relation(fields: [staffId], references: [id])
  deviceTokens UserDeviceToken[]
}

model DraftRule {
  id                     String   @id @default(cuid())
  active                 Boolean  @default(true)
  type                   String
  xmlType                String
  field                  String?
  name                   String
  description            String?
  code                   String
  conditionField         String?
  conditionValue         String?
  errorMessage           String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  checkNotNull           Boolean  @default(false)
  conditionMaDichVu      String?
  conditionMaDichVuValue String?
  excludeConditionField  String?
  excludeConditionValue  String?
  isGroupCount           Boolean  @default(false)
  mathExpression         String?
  maxCountVal            Int?
  minCountVal            Int?
}

model Department {
  ma_khoa      String       @id
  ten_khoa     String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  type         String       @default("CLINICAL")
  ma_khoa_bv   String?
  ten_khoa_bv  String?
  ma_khoa_bhyt String?
  BedCatalog   BedCatalog[]
  staff        Staff[]
  warehouses   Warehouse[]
}

model Staff {
  id                     String                  @id @default(cuid())
  ho_ten                 String
  ma_khoa                String
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  so_dien_thoai          String?
  chuc_danh_id           String?
  chuc_vu_id             String?
  gioi_tinh_id           String?
  loai_hop_dong_id       String?
  ngay_sinh              DateTime?
  trinh_do_id            String?
  vi_tri_viec_lam_id     String?
  trang_thai_id          String?
  dia_chi                String?
  ma_nv                  String                  @unique
  cccd                   String?
  ma_bhxh                String?
  ma_chuc_danh_bhyt      String?
  ma_vi_tri_bhyt         String?
  vi_tri_bhyt_id         String?
  dan_toc_id             String?
  certificates           PracticingCertificate[]
  chuc_danh_ref          SystemCategory?         @relation("StaffJobTitle", fields: [chuc_danh_id], references: [id])
  chuc_vu_ref            SystemCategory?         @relation("StaffPosition", fields: [chuc_vu_id], references: [id])
  gioi_tinh_ref          SystemCategory?         @relation("StaffGender", fields: [gioi_tinh_id], references: [id])
  loai_hop_dong_ref      SystemCategory?         @relation("StaffContractType", fields: [loai_hop_dong_id], references: [id])
  dan_toc_ref            SystemCategory?         @relation("StaffEthnicity", fields: [dan_toc_id], references: [id])
  department             Department              @relation(fields: [ma_khoa], references: [ma_khoa])
  trinh_do_ref           SystemCategory?         @relation("StaffQualification", fields: [trinh_do_id], references: [id])
  vi_tri_ref             SystemCategory?         @relation("StaffJobPosition", fields: [vi_tri_viec_lam_id], references: [id])
  trang_thai_ref         SystemCategory?         @relation("StaffWorkingStatus", fields: [trang_thai_id], references: [id])
  vi_tri_bhyt_ref        SystemCategory?         @relation("StaffBhytPosition", fields: [vi_tri_bhyt_id], references: [id])
  user                   User?
  storekeeper_warehouses Warehouse[]
  attendances            StaffAttendance[]

  ma_ho_gia_dinh String?
  ngay_cap_cccd  DateTime?
  noi_cap_cccd   String?

  noi_sinh_ward_id String?
  noi_sinh_thon    String?
  noi_sinh_ward    SystemCategory? @relation("StaffNoiSinh", fields: [noi_sinh_ward_id], references: [id])

  que_quan_ward_id String?
  que_quan_thon    String?
  que_quan_ward    SystemCategory? @relation("StaffQueQuan", fields: [que_quan_ward_id], references: [id])

  noi_o_ward_id String?
  noi_o_thon    String?
  noi_o_ward    SystemCategory? @relation("StaffNoiO", fields: [noi_o_ward_id], references: [id])

  so_qd_tuyen_dung     String?
  ngay_tuyen_dung      DateTime?
  thoi_diem_nang_luong DateTime?

  ma_ngach_id  String?
  ma_ngach_ref SystemCategory? @relation("StaffNgach", fields: [ma_ngach_id], references: [id])

  he_so_luong_id  String?
  he_so_luong_ref SystemCategory? @relation("StaffHeSo", fields: [he_so_luong_id], references: [id])

  bac_luong_id  String?
  bac_luong_ref SystemCategory? @relation("StaffBacLuong", fields: [bac_luong_id], references: [id])

  phu_cap_tnvk_id  String?
  phu_cap_tnvk_ref SystemCategory? @relation("StaffTNVK", fields: [phu_cap_tnvk_id], references: [id])

  trainings StaffTraining[]
}

model StaffTraining {
  id              String         @id @default(cuid())
  staffId         String
  staff           Staff          @relation(fields: [staffId], references: [id], onDelete: Cascade)
  trainingType_id String
  trainingType    SystemCategory @relation("TrainingType", fields: [trainingType_id], references: [id])
  name            String
  institution     String?
  graduationYear  Int?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model SystemCategory {
  id                String                  @id @default(cuid())
  type              String
  code              String
  name              String
  description       String?
  bhyt_code         String?
  isActive          Boolean                 @default(true)
  order             Int                     @default(0)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  staff_chuc_danh   Staff[]                 @relation("StaffJobTitle")
  staff_chuc_vu     Staff[]                 @relation("StaffPosition")
  staff_gioi_tinh   Staff[]                 @relation("StaffGender")
  staff_hop_dong    Staff[]                 @relation("StaffContractType")
  staff_trinh_do    Staff[]                 @relation("StaffQualification")
  staff_vi_tri      Staff[]                 @relation("StaffJobPosition")
  staff_dan_toc     Staff[]                 @relation("StaffEthnicity")
  staff_trang_thai  Staff[]                 @relation("StaffWorkingStatus")
  staff_vi_tri_bhyt Staff[]                 @relation("StaffBhytPosition")
  cchn_noi_cap      PracticingCertificate[] @relation("CertIssuePlace")
  staff_attendances StaffAttendance[]       @relation("AttendanceStatus")

  parentId String?
  parent   SystemCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children SystemCategory[] @relation("CategoryHierarchy")

  staff_noi_sinh_ward Staff[]         @relation("StaffNoiSinh")
  staff_que_quan_ward Staff[]         @relation("StaffQueQuan")
  staff_noi_o_ward    Staff[]         @relation("StaffNoiO")
  staff_ma_ngach      Staff[]         @relation("StaffNgach")
  staff_he_so_luong   Staff[]         @relation("StaffHeSo")
  staff_bac_luong     Staff[]         @relation("StaffBacLuong")
  staff_phu_cap_tnvk  Staff[]         @relation("StaffTNVK")
  staff_trainings     StaffTraining[] @relation("TrainingType")

  @@unique([type, code])
}

model PracticingCertificate {
  id                String             @id @default(cuid())
  staffId           String
  so_cchn           String
  ngay_cap          DateTime?
  chuc_danh_cchn    String?
  pham_vi_bo_sung   String?
  dich_vu_ky_thuat  String?
  noi_cap_cchn_id   String?
  vb_phan_cong      String?
  thoi_gian_dang_ky String?
  thoi_gian_ngay    String?
  thoi_gian_tuan    String?
  cskcb_khac        String?
  cskcb_cgkt        String?
  qd_cgkt           String?
  tu_ngay           DateTime?
  den_ngay          DateTime?
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  tt32_category_id  String?
  CCHNException     CCHNException[]
  staff             Staff              @relation(fields: [staffId], references: [id], onDelete: Cascade)
  TT32Category      TT32Category?      @relation(fields: [tt32_category_id], references: [id])
  noi_cap_cchn_ref  SystemCategory?    @relation("CertIssuePlace", fields: [noi_cap_cchn_id], references: [id])
  scopes            CCHNScopeMapping[]
}

model CCHNScopeMapping {
  cchn_id    String
  ma_pham_vi String
  createdAt  DateTime @default(now())

  certificate PracticingCertificate  @relation(fields: [cchn_id], references: [id], onDelete: Cascade)
  scope       ScopeOfPracticeCatalog @relation(fields: [ma_pham_vi], references: [ma_pham_vi], onDelete: Cascade)

  @@id([cchn_id, ma_pham_vi])
}

model DuplicateRule {
  id                    String   @id @default(cuid())
  ruleType              String   @default("EXCEL")
  name                  String
  machineCols           String[]
  serviceCol            String?
  startCol              String
  endCol                String
  ignoreMaMayMinusOne   Boolean  @default(false)
  ignoreNullValues      Boolean  @default(false)
  active                Boolean  @default(true)
  serviceValues         String[]
  excludedServiceValues String[]
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  ignoreIfSameField     String?
  minGapMinutes         Int      @default(0)
  departmentExclusions  Json?
  allowedOverlapGroups  Json?
}

model SpecializedRule {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  ruleType    String
  logicConfig Json?
  sqlQuery    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DepartmentCatalog {
  id          String   @id @default(uuid())
  STT         Int?
  MA_KHOA     String   @db.VarChar(50)
  TEN_KHOA    String
  BAN_KHAM    Int?
  GIUONG_PD   Int?
  GIUONG_TK   Int?
  GIUONG_HSTC Int?
  GIUONG_HSCC Int?
  TU_NGAY     String?  @db.VarChar(8)
  DEN_NGAY    String?  @db.VarChar(8)
  MA_CSKCB    String?  @db.VarChar(5)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Mau02Catalog {
  id            String   @id @default(uuid())
  STT           Int?
  MA_KHOA       String?  @db.VarChar(100)
  TEN_KHOA      String?
  HO_TEN        String?  @db.VarChar(250)
  GIOI_TINH     Int?
  SO_DINH_DANH  String?  @db.VarChar(50)
  CHUCDANH_NN   String?  @db.VarChar(50)
  VI_TRI        String?  @db.VarChar(50)
  MACCHN        String?  @db.VarChar(250)
  NGAYCAP_CCHN  String?  @db.VarChar(8)
  NOICAP_CCHN   String?  @db.VarChar(250)
  PHAMVI_CM     String?  @db.VarChar(250)
  PHAMVI_CMBS   String?  @db.VarChar(250)
  DVKT_KHAC     String?
  VB_PHANCONG   String?  @db.VarChar(250)
  THOIGIAN_DK   Int?
  THOIGIAN_NGAY String?  @db.VarChar(250)
  THOIGIAN_TUAN String?  @db.VarChar(200)
  CSKCB_KHAC    String?  @db.VarChar(30)
