model SystemConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model StaffAttendance {
  id                String          @id @default(cuid())
  staffId           String
  staff             Staff           @relation(fields: [staffId], references: [id])
  workDate          String          @db.VarChar(10) // YYYY-MM-DD
  statusId          String?
  status_ref        SystemCategory? @relation("AttendanceStatus", fields: [statusId], references: [id])
  is_thuc_hien_dvkt Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([staffId, workDate])
}

model PdfReport {
  id           String   @id @default(cuid())
  url          String
  ten_bao_cao  String
  loai_bao_cao String?
  ma_khoa      String?
  nguoi_tao    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ExcelTemplate {
  id        String                 @id @default(cuid())
  name      String
  isDefault Boolean                @default(false)
  mappings  ExcelTemplateMapping[]
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
}

model ExcelTemplateMapping {
  id           String        @id @default(cuid())
  templateId   String
  template     ExcelTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  system_field String
  excel_column String

  @@unique([templateId, system_field])
}

model ReportTemplate {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  description   String?
  reportType    String   @default("LISTING") // "LISTING" or "STATISTIC"
  excelFilePath String?
  startRow      Int      @default(8)
  groupBy       String   @default("none")
  columnMapping String?
  filters       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model DynamicForm {
  id          String            @id @default(cuid())
  name        String
  description String?
  slug        String            @unique
  config      Json?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  data        DynamicFormData[]
}

model DynamicFormData {
  id            String      @id @default(cuid())
  formId        String
  form          DynamicForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  data          Json
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  lastUpdatedBy String?
  isDone        Boolean     @default(false)
}

model ExtensionConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model ClinicalScheduleRecord {
  id              String   @id @default(cuid())
  so_phieu        String   // Số phiếu chỉ định
  ma_ba           String   // Mã bệnh án
  ten_bn          String   // Tên bệnh nhân
  ma_dich_vu      String   // Mã dịch vụ
  ten_dich_vu     String   // Tên dịch vụ
  ma_khoa         String   // Mã khoa
  ngay_thuc_hien  String   // Ngày thực hiện (YYYY-MM-DD)
  bat_dau         String   // Giờ bắt đầu (HH:mm)
  ket_thuc        String   // Giờ kết thúc (HH:mm)
  nguoi_thuc_hien String   // Tên người thực hiện
  ma_nv           String   // Mã nhân viên
  ma_may          String?  // Mã máy
  ten_may         String?  // Tên máy
  trang_thai      String   @default("SCHEDULED")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([ngay_thuc_hien, ma_khoa])
}
